<header class="header-brasil">
  <div class="floating-icons">
    <!-- Calculadora simples SVG -->
    <svg class="float-icon calc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="4" y="2" width="16" height="20" rx="2"/>
      <path d="M8 7h8M8 11h8M8 15h.01M12 15h.01M16 15h.01M8 19h.01M12 19h.01M16 19h.01"/>
    </svg>

    <!-- Cifrão / Dinheiro SVG (estilo R$) -->
    <svg class="float-icon money" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H7"/>
    </svg>

    <!-- Notas de dinheiro SVG (pilha) -->
    <svg class="float-icon notes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="2" y="6" width="20" height="14" rx="2"/>
      <path d="M6 10h12M6 14h12"/>
    </svg>

    <!-- Gráfico de imposto (barras) SVG -->
    <svg class="float-icon chart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M3 3v18h18M7 10v8M11 7v11M15 13v5M19 5v13"/>
    </svg>
  </div>

  <div class="header-content">
    <h1>Calculadora de Impostos Brasil</h1>
    <p>Simule IR, INSS, IOF e mais!</p>
  </div>
</header>

/* Mesmo CSS de antes, só ajustando cor dos SVGs */
.float-icon {
  position: absolute;
  width: 80px;
  height: 80px;
  opacity: 0.15;
  color: #ffffff; /* ou #FFD700 para dourado, #00FF00 para verde bandeira */
  animation: float 12s infinite ease-in-out;
}

/* Posições e animação iguais */
.calc { top: 15%; left: 10%; animation-delay: 0s; }
.money { top: 35%; right: 12%; animation-delay: 2.5s; }
.notes { bottom: 25%; left: 18%; animation-delay: 5s; }
.chart { bottom: 15%; right: 20%; animation-delay: 7.5s; }

@keyframes float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-40px) rotate(8deg); }
}
